generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                    String    @id @default(cuid())
  discordGuildId        String    @unique
  name                  String
  ownerUserId           String?
  announcementChannelId String?
  helpForumChannelId    String?
  taUserIds             String[] // Discord user IDs allowed to use /ta and the dashboard
  installedAt           DateTime  @default(now())
  items                 Item[]
  students              Student[]
}

model Student {
  id                String            @id @default(cuid())
  guildId           String
  discordUserId     String // Discord snowflakes are ALWAYS String
  consentedAt       DateTime?
  revokedAt         DateTime?
  helperOptIn       Boolean           @default(false) // opted in to be offered as a peer helper
  guild             Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  statuses          ItemStatus[]
  helpRequests      HelpRequest[]
  topicRoomMembers  TopicRoomMember[]
  matchesAsReceiver Match[]           @relation("receiver")
  matchesAsProvider Match[]           @relation("provider")

  @@unique([guildId, discordUserId])
}

enum ItemKind {
  ASSIGNMENT
  QUIZ
  EXAM
  READING
}

model Item {
  id                String       @id @default(cuid())
  guildId           String
  title             String
  description       String?
  dueAt             DateTime?
  kind              ItemKind     @default(ASSIGNMENT)
  sourceMessageId   String?
  discordCategoryId String?
  createdAt         DateTime     @default(now())
  guild             Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  concepts          Concept[]
  statuses          ItemStatus[]
  matches           Match[]
}

enum StatusState {
  NONE
  IN_PROGRESS
  DONE
  STUCK
}

model ItemStatus {
  id         String      @id @default(cuid())
  itemId     String
  studentId  String
  state      StatusState @default(NONE)
  conceptId  String?
  updatedAt  DateTime    @updatedAt
  remindedAt DateTime?
  item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept    Concept?    @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@unique([itemId, studentId])
}

model Concept {
  id           String        @id @default(cuid())
  itemId       String
  label        String // normalized: trimmed, lowercased, punctuation stripped
  aliases      String[]
  createdAt    DateTime      @default(now())
  item         Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  statuses     ItemStatus[]
  helpRequests HelpRequest[]
  answers      Answer[]
  topicRoom    TopicRoom?
  matches      Match[]

  @@unique([itemId, label])
}

enum RequestState {
  OPEN
  ANSWERED
  CLOSED
}

enum TopicRoomState {
  OPEN
  CLOSED
}

model TopicRoom {
  id             String            @id @default(cuid())
  conceptId      String            @unique
  channelId      String?           @unique
  state          TopicRoomState    @default(OPEN)
  createdAt      DateTime          @default(now())
  closedAt       DateTime?
  closedById     String?
  provisioningAt DateTime?
  concept        Concept           @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  members        TopicRoomMember[]
}

model TopicRoomMember {
  id        String    @id @default(cuid())
  roomId    String
  studentId String
  joinedAt  DateTime  @default(now())
  room      TopicRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([roomId, studentId])
}

model HelpRequest {
  id        String       @id @default(cuid())
  conceptId String
  studentId String
  state     RequestState @default(OPEN)
  createdAt DateTime     @default(now())
  concept   Concept      @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([conceptId, studentId])
}

model Answer {
  id              String    @id @default(cuid())
  conceptId       String
  authorUserId    String
  body            String
  createdAt       DateTime  @default(now())
  deliveredAt     DateTime? // null = outbox; bot delivers and stamps
  deliveredCount  Int       @default(0)
  pinnedMessageId String?
  threadMessageId String?
  concept         Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
}

// ==== Peer matching (docs/personal_handoff/peer-matching-handoff.md §2) ====
// No message table: relayed text is forwarded by the bot and never stored.

enum MatchState {
  PENDING // offer sent to providers, nobody accepted yet
  ACTIVE // one provider accepted, relay is open
  RESOLVED // either side tapped Resolved
  EXPIRED // 30 min with no acceptance, receiver sent to TA path
  REPORTED // either side tapped Report; TAs notified with match id only
}

model Match {
  id               String     @id @default(cuid())
  itemId           String
  conceptId        String?
  receiverId       String // Student.id, the stuck student
  providerId       String? // Student.id, null while PENDING
  offeredTo        String[] // Student.id values the offer was sent to
  state            MatchState @default(PENDING)
  receiverRevealed Boolean    @default(false)
  providerRevealed Boolean    @default(false)
  createdAt        DateTime   @default(now())
  acceptedAt       DateTime?
  resolvedAt       DateTime?
  item             Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  concept          Concept?   @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  receiver         Student    @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  provider         Student?   @relation("provider", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([receiverId, state])
  @@index([providerId, state])
}
