{
  "name": "classync",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=apps/bot",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "prisma db push --schema=packages/core/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=packages/core/prisma/schema.prisma",
    "db:seed": "tsx packages/core/prisma/seed.ts",
    "register": "npm run register --workspace=apps/bot",
    "postinstall": "prisma generate --schema=packages/core/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dicebear/collection": "9.4.2",
    "@dicebear/core": "9.4.3"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.19.0"
  }
}
