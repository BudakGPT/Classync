# ==== DATABASE ====
# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/classync?sslmode=require"

# ==== DISCORD BOT ====
# From Discord Developer Portal → Your App → Bot
DISCORD_TOKEN="your-bot-token-here"

# From Discord Developer Portal → Your App → General Information
DISCORD_CLIENT_ID="your-client-id-here"

# Client secret — for OAuth2 (web dashboard login)
DISCORD_CLIENT_SECRET="your-client-secret-here"

# Your test server (guild) ID — right-click server → Copy Server ID
DISCORD_GUILD_ID="your-guild-id-here"

# ==== NEXTAUTH (Auth.js v5) ====
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# ==== LLM (OPTIONAL) ====
# If not set, announcement parsing falls back to first-line title
ANTHROPIC_API_KEY=""

# ==== FEATURE FLAGS ====
# Auto-ingest (B6) parses announcements into Items. Off by default — it runs on every
# message and is the riskiest path on stage. `/ta add-item` is the fallback.
ENABLE_AUTO_INGEST="false"

# ==== SEED DATA (for prisma/seed.ts) ====
# Real Discord user IDs for the team — used in seed so dashboard works with real accounts
SEED_TA_DISCORD_ID="your-discord-id-here"
SEED_STUDENT_1_DISCORD_ID=""
SEED_STUDENT_2_DISCORD_ID=""
SEED_STUDENT_3_DISCORD_ID=""
