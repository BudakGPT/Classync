# ==== DATABASE ====
# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/classync?sslmode=require"

# ==== DISCORD BOT ====
# From Discord Developer Portal → Your App → Bot
DISCORD_TOKEN="your-bot-token-here"

# From Discord Developer Portal → Your App → General Information
DISCORD_CLIENT_ID="your-client-id-here"

# Client secret — for OAuth2 (web dashboard login)
DISCORD_CLIENT_SECRET="your-client-secret-here"

# Your test server (guild) ID — right-click server → Copy Server ID
DISCORD_GUILD_ID="your-guild-id-here"

# ==== NEXTAUTH (Auth.js v5) ====
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# ==== LLM (optional) ====
# OpenRouter key for roster column detection on upload. Leave empty: header heuristics are used instead.
# Only the header row and masked sample cells are sent; NPMs and names never leave the server.
OPENROUTER_API_KEY=""
# Optional model override (default: google/gemini-2.0-flash-lite-preview-02-05:free)
OPENROUTER_MODEL=""

# ==== WEB DASHBOARD ====
# Public URL of the TA dashboard. The bot links to it from /setup embeds and the TA panel.
WEB_URL="http://localhost:3000"

# ==== SEED DATA (for prisma/seed.ts) ====
# Real Discord user IDs for the team — used in seed so dashboard works with real accounts
SEED_TA_DISCORD_ID="your-discord-id-here"
SEED_STUDENT_1_DISCORD_ID=""
SEED_STUDENT_2_DISCORD_ID=""
SEED_STUDENT_3_DISCORD_ID=""
# Announcement channel ID the seeded guild points at (optional; a placeholder is used if empty)
SEED_ANNOUNCEMENT_CHANNEL_ID=""
